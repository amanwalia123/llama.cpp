#!/usr/bin/env bash
#
# llama-ctl - lifecycle manager for the local llama-server
#
# Usage:
#   llama-ctl start              Start the server in a tmux/screen session
#   llama-ctl stop               Kill the server session
#   llama-ctl restart            Stop, then start
#   llama-ctl status             Show whether the server is running
#   llama-ctl logs               Attach to the session (live logs)
#   llama-ctl url                Print the WebUI / OpenAI-compat URL
#   llama-ctl uninstall          Remove all llama.cpp installation artifacts
#   llama-ctl --help             Show this help
#
# Environment overrides:
#   LLAMA_CTL_PORT     Server port               (default: 11435)
#   LLAMA_CTL_MODELS   Path to models.ini        (default: ~/.llama/models.ini)
#   LLAMA_CTL_SESSION  tmux/screen session name  (default: llama-server)
#
# Auto-detects tmux (preferred) or screen. Installed alongside llama-server
# in ~/.bin by install.sh.

set -euo pipefail

PORT="${LLAMA_CTL_PORT:-11435}"
MODELS_INI="${LLAMA_CTL_MODELS:-${HOME}/.llama/models.ini}"
SESSION="${LLAMA_CTL_SESSION:-llama-server}"

C_INFO=$'\033[1;34m'; C_OK=$'\033[1;32m'; C_WARN=$'\033[1;33m'; C_ERR=$'\033[1;31m'; C_OFF=$'\033[0m'
log()  { echo "${C_INFO}[llama-ctl]${C_OFF} $*" >&2; }
ok()   { echo "${C_OK}[  ok  ]${C_OFF} $*" >&2; }
warn() { echo "${C_WARN}[ warn ]${C_OFF} $*" >&2; }
err()  { echo "${C_ERR}[error ]${C_OFF} $*" >&2; }

find_server() {
    if command -v llama-server >/dev/null 2>&1; then
        command -v llama-server
        return
    fi
    for cand in \
        "${HOME}/.bin/llama-server" \
        "${HOME}/.llama/build/build/bin/llama-server" \
        "${HOME}/.llama/build/bin/llama-server"; do
        [[ -x "$cand" ]] && { echo "$cand"; return; }
    done
    return 1
}

detect_mux() {
    if command -v tmux   >/dev/null 2>&1; then echo tmux;   return; fi
    if command -v screen >/dev/null 2>&1; then echo screen; return; fi
    return 1
}

machine_ip() {
    hostname -I 2>/dev/null | awk '{print $1}' || echo localhost
}

# Server launch args. Keep in sync with install.sh::prompt_start_server.
server_args() {
    cat <<EOF
--models-preset $MODELS_INI --host 0.0.0.0 --port $PORT --jinja --n-gpu-layers all --flash-attn on --split-mode layer --tensor-split 1,1 --parallel 1 --slots --ctx-size 200000 --batch-size 4096 --ubatch-size 1024 --cache-type-k q8_0 --cache-type-v q8_0 --reasoning on --tools all --models-max 1
EOF
}

is_running() {
    local mux="$1"
    if [[ "$mux" == tmux ]]; then
        tmux has-session -t "$SESSION" 2>/dev/null
    else
        screen -ls 2>/dev/null | grep -q "\.${SESSION}\b"
    fi
}

cmd_url() {
    local ip; ip="$(machine_ip)"
    echo ""
    echo "  Llama Server:  http://${ip}:${PORT}"
    echo "  OpenAI API:    http://${ip}:${PORT}/v1"
    echo "  Open WebUI:    http://${ip}:3001"
    echo ""
}

ensure_uvx() {
    if command -v uvx >/dev/null 2>&1; then
        command -v uvx
        return
    fi
    if [[ -x "${HOME}/.local/bin/uvx" ]]; then
        echo "${HOME}/.local/bin/uvx"
        return
    fi

    read -rp "uvx not found. Install uv (provides uvx)? [y/N] " answer
    case "$answer" in
        [yY][eE][sS]|[yY]) ;;
        *) err "uvx is required. Install with: curl -LsSf https://astral.sh/uv/install.sh | sh"; exit 1 ;;
    esac

    log "Installing uv..."
    if curl -LsSf https://astral.sh/uv/install.sh | sh; then
        local bin="${HOME}/.local/bin/uvx"
        if [[ -x "$bin" ]]; then
            echo "$bin"
            return
        fi
        if command -v uvx >/dev/null 2>&1; then
            command -v uvx
            return
        fi
    fi

    err "Failed to install uv. Try: curl -LsSf https://astral.sh/uv/install.sh | sh"
    exit 1
}

cmd_webui_start() {
    local mux; mux="$(detect_mux)" || { err "Neither tmux nor screen installed."; exit 1; }
    local uvx; uvx="$(ensure_uvx)"

    # Command to serve Open WebUI on port 3001, host 0.0.0.0
    local cmd="DATA_DIR=${HOME}/.open-webui $uvx --python 3.11 open-webui@latest serve --port 3001 --host 0.0.0.0"

    if [[ "$mux" == tmux ]]; then
        if tmux has-session -t "$SESSION" 2>/dev/null; then
            # Kill stale window first so re-runs don't hit "index N in use"
            tmux kill-window -t "${SESSION}:OpenWebUI" 2>/dev/null || true
            tmux new-window -t "${SESSION}:" -d -n OpenWebUI "$cmd"
        else
            log "Tmux session '$SESSION' not found. Creating it..."
            tmux new-session -d -s "$SESSION" -n OpenWebUI "$cmd"
        fi
    else
        screen -dmS "llama-server-OpenWebUI" bash -c "$cmd"
    fi

    ok "Started Open WebUI in $mux session/window (named 'OpenWebUI')"
    cmd_url
}

cmd_webui_stop() {
    local mux; mux="$(detect_mux)" || { err "Neither tmux nor screen installed."; exit 1; }

    if [[ "$mux" == tmux ]]; then
        # Kill only the OpenWebUI window
        tmux kill-window -t "$SESSION":OpenWebUI 2>/dev/null || warn "OpenWebUI window not found."
    else
        screen -S "llama-server-OpenWebUI" -X quit 2>/dev/null || warn "OpenWebUI session not found."
    fi
    ok "Stopped Open WebUI"
}

cmd_webui_status() {
    local mux; mux="$(detect_mux)" || { err "Neither tmux nor screen installed."; exit 1; }

    if [[ "$mux" == tmux ]]; then
        if tmux has-window -t "$SESSION":OpenWebUI 2>/dev/null; then
            ok "Open WebUI is running (tmux window: OpenWebUI)"
        else
            warn "Open WebUI is not running."
            exit 1
        fi
    else
        if screen -ls 2>/dev/null | grep -q "\.llama-server-OpenWebUI\b"; then
            ok "Open WebUI is running (screen session: llama-server-OpenWebUI)"
        else
            warn "Open WebUI is not running."
            exit 1
        fi
    fi
}

cmd_webui_restart() {
    cmd_webui_stop || true
    cmd_webui_start
}

cmd_start() {
    local mux; mux="$(detect_mux)" || { err "Neither tmux nor screen installed."; exit 1; }
    local bin; bin="$(find_server)" || { err "llama-server binary not found in PATH or ~/.bin/."; exit 1; }
    [[ -f "$MODELS_INI" ]] || { err "Models preset not found: $MODELS_INI (re-run install.sh)"; exit 1; }

    if is_running "$mux"; then
        ok "Already running ($mux session: $SESSION)"
        cmd_url
        return
    fi

    local cmd="$bin $(server_args)"
    if [[ "$mux" == tmux ]]; then
        tmux new-session -d -s "$SESSION" -n llama-server "$cmd"
    else
        screen -dmS "$SESSION" bash -c "$cmd"
    fi
    ok "Started llama-server in $mux session '$SESSION' (window: llama-server)"
    cmd_webui_start
}

cmd_stop() {
    local mux; mux="$(detect_mux)" || { err "Neither tmux nor screen installed."; exit 1; }
    if ! is_running "$mux"; then
        warn "Not running."
        return
    fi
    if [[ "$mux" == tmux ]]; then
        tmux kill-session -t "$SESSION"
    else
        screen -S "$SESSION" -X quit
    fi
    ok "Stopped session '$SESSION'"
}

cmd_status() {
    local mux; mux="$(detect_mux)" || { err "Neither tmux nor screen installed."; exit 1; }
    if is_running "$mux"; then
        ok "Running ($mux session: $SESSION)"
        cmd_url
    else
        warn "Not running."
        exit 1
    fi
}

cmd_logs() {
    local mux; mux="$(detect_mux)" || { err "Neither tmux nor screen installed."; exit 1; }
    if ! is_running "$mux"; then
        err "Not running. Start it first: llama-ctl start"
        exit 1
    fi
    if [[ "$mux" == tmux ]]; then
        log "Detach with: Ctrl-b d  (Ctrl-C would kill the server)"
        exec tmux attach -t "$SESSION"
    else
        log "Detach with: Ctrl-a d  (Ctrl-C would kill the server)"
        exec screen -r "$SESSION"
    fi
}

cmd_uninstall() {
    local install_dir="${HOME}/.bin"
    local models_dir="${HOME}/.llama/models"
    local build_dir="${HOME}/.llama/build"
    local models_ini="${HOME}/.llama/models.ini"
    local force=false

    # Parse optional flags
    for arg in "$@"; do
        case "$arg" in
            --force) force=true ;;
        esac
    done


    # Read tracked repo for display
    local _tracked_repo=""
    if [[ -f "${HOME}/.llama/install-state" ]]; then
        _tracked_repo="$(cat "${HOME}/.llama/install-state")"
        # Only show if outside ~/.llama/build
        if [[ "$_tracked_repo" == "${HOME}/.llama/build"* ]]; then
            _tracked_repo=""
        fi
    fi
    echo "╔══════════════════════════════════════════════════════╗"
    echo "║           llama.cpp Uninstall Utility               ║"
    echo "╠══════════════════════════════════════════════════════╣"
    echo "║  Binaries dir:  $install_dir"
    echo "║  Models dir:    $models_dir"
    echo "║  Build dir:     $build_dir"
    echo "║  Presets file:  $models_ini"
    if [[ -n "$_tracked_repo" ]]; then
        echo "║  Repo dir:    $_tracked_repo"
    fi
    echo "╚══════════════════════════════════════════════════════╝"
    echo ""

    if [[ "$force" == false ]]; then
        read -rp "This will permanently delete the above directories and files. Continue? [y/N] " answer
        case "$answer" in
            [yY][eE][sS]|[yY]) ;;
            *) log "Uninstall cancelled."; exit 0 ;;
        esac
    fi

    # Ask explicitly about removing models
    local remove_models=false
    if [[ -d "$models_dir" ]]; then
        local model_file_count
        model_file_count=$(find "$models_dir" -name '*.gguf' -not -name '*.gguf.*' 2>/dev/null | wc -l)
        if [[ "$model_file_count" -gt 0 ]]; then
            read -rp "Remove $model_file_count model file(s) from $models_dir? [y/N] " answer
            case "$answer" in
                [yY][eE][sS]|[yY]) remove_models=true ;;
                *) warn "Keeping model files in $models_dir" ;;
            esac
        fi
    fi

    # 1. Remove Binaries
    if [[ -d "$install_dir" ]]; then
        log "Removing binaries from $install_dir..."
        for bin in llama-server llama-cli llama-quantize llama-ctl; do
            if [[ -L "${install_dir}/${bin}" ]]; then
                rm "${install_dir}/${bin}"
                ok "Removed symlink: ${bin}"
            fi
        done
    else
        warn "Installation directory $install_dir not found. Skipping."
    fi

    # 2. Remove Models and Presets
    if [[ -f "$models_ini" ]]; then
        log "Removing presets file: $models_ini"
        rm "$models_ini"
        ok "Deleted $models_ini"
    fi

    if [[ "$remove_models" == true ]]; then
        if [[ -d "$models_dir" ]]; then
            log "Removing models directory: $models_dir"
            rm -rf "$models_dir"
            ok "Deleted $models_dir"
        else
            warn "Models directory $models_dir not found. Skipping."
        fi
    fi

    # 3. Remove Build Artifacts
    if [[ -d "$build_dir" ]]; then
        log "Removing build directory: $build_dir"
        rm -rf "$build_dir"
        ok "Deleted $build_dir"
    else
        warn "Build directory $build_dir not found. Skipping."
    fi

    # 4. Remove tracked repo directory (if outside ~/.llama/build)
    local state_file="${HOME}/.llama/install-state"
    if [[ -f "$state_file" ]]; then
        local tracked_repo
        tracked_repo="$(cat "$state_file")"

        # Skip if repo is under ~/.llama/build (already removed in step 3)
        if [[ "$tracked_repo" != "${HOME}/.llama/build"* ]]; then
            if [[ -d "$tracked_repo" ]]; then
                if [[ "$force" == true ]]; then
                    log "Removing tracked repo: $tracked_repo"
                    rm -rf "$tracked_repo"
                    ok "Deleted $tracked_repo"
                else
                    read -rp "Remove tracked repo at $tracked_repo? [y/N] " answer
                    case "$answer" in
                        [yY][eE][sS]|[yY])
                            log "Removing tracked repo: $tracked_repo"
                            rm -rf "$tracked_repo"
                            ok "Deleted $tracked_repo"
                            ;;
                        *) warn "Skipping tracked repo." ;;
                    esac
                fi
            else
                warn "Tracked repo $tracked_repo not found. Skipping."
            fi
        fi

        # Remove state file
        rm -f "$state_file"
    fi

    echo ""
    ok "Uninstallation complete. All llama.cpp artifacts have been removed."
}

cmd_help() {
    sed -n '3,/^$/s/^# \?//p' "$0"
    exit 0
}

# ─── Shared helpers (from install.sh) ────────────────────────────────────────────

MODELS_DIR="${HOME}/.llama/models"
REPO_DIR_FILE="${HOME}/.llama/install-state"
BUILD_DIR="${HOME}/.llama/build"
BUILD_STATE="${HOME}/.llama/build-state"

# Returns true if the filename belongs to an mmproj file.
is_mmproj_file() {
    local fname
    fname="$(basename "$1")"
    case "$fname" in
        *.mmproj)    return 0 ;;
        mmproj*)    return 0 ;;
        *mmproj*)    return 0 ;;
        *mm-project*) return 0 ;;
    esac
    return 1
}

is_first_shard() {
    local fname
    fname="$(basename "$1")"
    case "$fname" in
        *-00001-of-*) return 0 ;;
    esac
    return 1
}

is_shard() {
    local fname
    fname="$(basename "$1")"
    case "$fname" in
        *-[0-9][0-9][0-9][0-9][0-9]-of-*) return 0 ;;
    esac
    return 1
}

# Derive a unique preset name from a model file path.
model_preset_name() {
    local model_path="$1"
    local models_dir="$2"
    local rel="${model_path#"$models_dir"/}"

    local name
    if [[ "$rel" == */* ]]; then
        name="$(dirname "$rel")"
    else
        name="${rel%.gguf}"
    fi

    name="$(echo "$name" | tr '[:upper:]' '[:lower:]')"
    name="${name//-gguf/}"
    name="${name//-it/}"
    name="${name//-a3b-ud-/}"
    name="$(echo "$name" | sed 's/[^a-z0-9._-]/_/g')"

    echo "$name"
}

# Find a companion mmproj file for a given model path.
find_mmproj() {
    local model_dir
    model_dir="$(dirname "$1")"
    local model_base
    model_base="$(basename "$1" .gguf)"

    if [[ -f "${model_dir}/${model_base}.mmproj" ]]; then
        echo "${model_dir}/${model_base}.mmproj"
        return
    fi

    local mmproj_shard
    mmproj_shard=$(find "$model_dir" -maxdepth 1 -name 'mmproj-00001-of-*.gguf' -print -quit 2>/dev/null || true)
    if [[ -n "$mmproj_shard" ]]; then
        echo "$mmproj_shard"
        return
    fi

    local any_mmproj
    any_mmproj=$(find "$model_dir" -maxdepth 1 -name '*.mmproj' -not -name '*.mmproj.*' -print -quit 2>/dev/null || true)
    if [[ -n "$any_mmproj" ]]; then
        echo "$any_mmproj"
        return
    fi

    local any_mmproj_gguf
    any_mmproj_gguf=$(find "$model_dir" -maxdepth 1 -name '*mmproj*.gguf' -print -quit 2>/dev/null || true)
    if [[ -n "$any_mmproj_gguf" ]]; then
        echo "$any_mmproj_gguf"
        return
    fi
}

# Returns true if a GGUF file contains MTP tensors.
model_has_mtp() {
    local gguf_file="$1"
    if strings "$gguf_file" 2>/dev/null | grep -q -- 'mtp'; then
        return 0
    fi
    return 1
}

# Emit a single model's INI section to stdout
emit_model_section() {
    local gguf_file="$1"
    local models_dir="$2"

    local preset_name
    preset_name="$(model_preset_name "$gguf_file" "$models_dir")"

    echo ""
    echo "[$preset_name]"
    echo "model = $gguf_file"

    local mmproj_path
    mmproj_path="$(find_mmproj "$gguf_file")"
    if [[ -n "$mmproj_path" ]]; then
        echo "mmproj = $mmproj_path"
    fi

    if model_has_mtp "$gguf_file"; then
        echo "spec-type = draft-mtp"
        echo "spec-draft-n-max = 3"
        echo "spec-draft-n-min = 2"
        echo "spec-draft-p-split = 0.15"
        echo "spec-draft-p-min = 0.6"
        echo "spec-draft-ngl = auto"
        echo "spec-draft-type-k = q8_0"
        echo "spec-draft-type-v = q8_0"
        echo "spec-default = true"
    fi
}

# Regenerate models.ini (same logic as install.sh::generate_models_ini)
regenerate_models_ini() {
    mkdir -p "$(dirname "$MODELS_INI")"

    {
        echo "version = 1"
        echo ""
        echo "[*]"
        echo "jinja = true"

        if [[ -d "$MODELS_DIR" ]]; then
            while IFS= read -r -d '' gguf_file; do
                local fname
                fname="$(basename "$gguf_file")"
                is_mmproj_file "$gguf_file" && continue
                [[ "$fname" != *.gguf ]] && continue
                [[ "$fname" == *.gguf.* ]] && continue
                is_shard "$gguf_file" && ! is_first_shard "$gguf_file" && continue
                emit_model_section "$gguf_file" "$MODELS_DIR"
            done < <(find "$MODELS_DIR" -maxdepth 3 -name '*.gguf' -not -name '*.gguf.*' -print0 2>/dev/null | sort -z)
        fi

    } > "$MODELS_INI"

    local model_count
    model_count=$(grep -c '^\[' "$MODELS_INI" 2>/dev/null || echo 0)
    model_count=$((model_count - 1))
    [[ $model_count -lt 0 ]] && model_count=0

    ok "Regenerated ${MODELS_INI} with $model_count model preset(s)."
}

# Locate the llama.cpp repository directory
find_repo() {
    if [[ -f "$REPO_DIR_FILE" ]]; then
        local tracked
        tracked="$(cat "$REPO_DIR_FILE")"
        if [[ -d "$tracked" && -f "$tracked/.git" ]]; then
            echo "$tracked"
            return
        fi
    fi
    if [[ -d "${BUILD_DIR}/.git" ]]; then
        echo "$BUILD_DIR"
        return
    fi
    # Fallback: check if we're inside a git repo
    if git rev-parse --git-dir >/dev/null 2>&1; then
        git rev-parse --show-toplevel
        return
    fi
    return 1
}

# Locate the build directory (CMake build output)
find_build() {
    if [[ -d "${BUILD_DIR}/bin" ]]; then
        echo "$BUILD_DIR"
        return
    fi
    local repo
    repo="$(find_repo)" || true
    if [[ -n "$repo" && -d "${repo}/build/bin" ]]; then
        echo "${repo}/build"
        return
    fi
    return 1
}

# ─── Model management commands ──────────────────────────────────────────────────

cmd_model_add() {
    local target="$1"
    if [[ -z "$target" ]]; then
        err "Usage: llama-ctl model add <path/to/model.gguf> [options]"
        echo "  Options:"
        echo "    --copy       Copy model to ~/.llama/models/ (default: reference in-place)"
        echo "    --restart    Restart server after adding"
        exit 1
    fi

    local copy=false restart=false
    shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --copy)    copy=true ;;
            --restart) restart=true ;;
            *)         err "Unknown option: $1"; exit 1 ;;
        esac
        shift
    done

    local final_path="$target"

    if [[ -d "$target" ]]; then
        # Directory: copy new .gguf files to MODELS_DIR, skip pre-existing ones
        if [[ "$copy" == false ]]; then
            err "Directory mode requires --copy flag."
            exit 1
        fi
        mkdir -p "$MODELS_DIR"
        local count_new=0 count_skipped=0
        while IFS= read -r -d '' gguf_file; do
            local fname
            fname="$(basename "$gguf_file")"
            is_mmproj_file "$gguf_file" && continue
            is_shard "$gguf_file" && ! is_first_shard "$gguf_file" && continue
            [[ "$fname" != *.gguf ]] && continue
            [[ "$fname" == *.gguf.* ]] && continue

            local pname
            pname="$(model_preset_name "$gguf_file" "$MODELS_DIR")"

            # Skip if model already exists in MODELS_DIR (same name + same size)
            if [[ -f "$MODELS_DIR/$fname" ]]; then
                local src_size dst_size
                src_size=$(stat -c%s "$gguf_file" 2>/dev/null || stat -f%z "$gguf_file" 2>/dev/null)
                dst_size=$(stat -c%s "$MODELS_DIR/$fname" 2>/dev/null || stat -f%z "$MODELS_DIR/$fname" 2>/dev/null)
                if [[ "$src_size" == "$dst_size" ]]; then
                    warn "Already present (same file): $fname — skipping"
                    count_skipped=$((count_skipped + 1))
                    continue
                fi
            fi

            # Skip if preset already registered in models.ini (even if file differs)
            if [[ -f "$MODELS_INI" ]] && grep -q "^\[$pname\]" "$MODELS_INI" 2>/dev/null; then
                warn "Already registered: [$pname] — skipping"
                count_skipped=$((count_skipped + 1))
                continue
            fi

            cp "$gguf_file" "$MODELS_DIR/" && count_new=$((count_new + 1))
            # Also copy companion mmproj if any
            local mmproj
            mmproj="$(find_mmproj "$gguf_file")"
            if [[ -n "$mmproj" && ! -f "$MODELS_DIR/$(basename "$mmproj")" ]]; then
                cp "$mmproj" "$MODELS_DIR/"
            fi
        done < <(find "$target" -maxdepth 3 -name '*.gguf' -not -name '*.gguf.*' -print0 2>/dev/null)
        ok "Added $count_new new model(s) from $target to $MODELS_DIR"
        [[ $count_skipped -gt 0 ]] && warn "Skipped $count_skipped pre-existing model(s)"
    elif [[ -f "$target" ]]; then
        local pname
        pname="$(model_preset_name "$target" "$target")"

        if [[ "$copy" == true ]]; then
            mkdir -p "$MODELS_DIR"
            local dst_file="$MODELS_DIR/$(basename "$target")"

            # Skip if identical file already exists in MODELS_DIR
            if [[ -f "$dst_file" ]]; then
                local src_size dst_size
                src_size=$(stat -c%s "$target" 2>/dev/null || stat -f%z "$target" 2>/dev/null)
                dst_size=$(stat -c%s "$dst_file" 2>/dev/null || stat -f%z "$dst_file" 2>/dev/null)
                if [[ "$src_size" == "$dst_size" ]]; then
                    warn "File already present in $MODELS_DIR — skipping copy"
                fi
            fi

            if [[ ! -f "$dst_file" ]] || [[ "$src_size" != "$dst_size" ]]; then
                cp "$target" "$MODELS_DIR/"
                ok "Copied $(basename "$target") to $MODELS_DIR"
            fi
            final_path="$dst_file"
            # Also copy companion mmproj if any
            local mmproj
            mmproj="$(find_mmproj "$target")"
            if [[ -n "$mmproj" && ! -f "$MODELS_DIR/$(basename "$mmproj")" ]]; then
                cp "$mmproj" "$MODELS_DIR/"
            fi
        else
            # For in-place references, append section directly to models.ini
            if [[ -f "$MODELS_INI" ]] && grep -q "^\[$pname\]" "$MODELS_INI" 2>/dev/null; then
                warn "Preset [$pname] already registered in $MODELS_INI, skipping."
                return 0
            fi

            ok "Referencing model in-place: $target"
            mkdir -p "$(dirname "$MODELS_INI")"
            if [[ ! -f "$MODELS_INI" ]]; then
                echo "version = 1" > "$MODELS_INI"
                echo "" >> "$MODELS_INI"
                echo "[*]" >> "$MODELS_INI"
                echo "jinja = true" >> "$MODELS_INI"
            fi
            emit_model_section "$target" "$target" >> "$MODELS_INI"
            ok "Added [$pname] to $MODELS_INI"
        fi
    else
        err "Path not found: $target"
        exit 1
    fi

    # Only regenerate models.ini if we copied files (in-place mode appends directly)
    if [[ "$copy" == true ]]; then
        regenerate_models_ini
    fi

    if [[ "$restart" == true ]]; then
        local mux; mux="$(detect_mux)" || { err "No tmux/screen."; exit 1; }
        if is_running "$mux"; then
            log "Restarting server..."
            cmd_stop
            sleep 1
            cmd_start
        else
            warn "Server not running. Starting..."
            cmd_start
        fi
    fi
}

cmd_model_list() {
    if [[ ! -f "$MODELS_INI" ]]; then
        err "Models preset not found: $MODELS_INI"
        exit 1
    fi

    echo ""
    printf "  %-30s %-50s %s\n" "PRESET" "MODEL PATH" "TAGS"
    echo "  $(printf '%.0s─' {1..120})"

    local in_section=false current_name="" current_model="" has_mmproj=false has_mtp=false
    while IFS= read -r line; do
        # Trim whitespace
        line="$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        [[ -z "$line" ]] && continue

        if [[ "$line" =~ ^\[([^]]+)\]$ ]]; then
            # Emit previous section if any
            if [[ "$in_section" == true && -n "$current_model" ]]; then
                local tags=""
                [[ "$has_mmproj" == true ]] && tags="mmproj"
                [[ "$has_mtp" == true ]] && { [[ -n "$tags" ]] && tags="$tags, "; tags="${tags}MTP"; }
                [[ -z "$tags" ]] && tags="-"
                printf "  %-30s %-50s %s\n" "$current_name" "$current_model" "$tags"
            fi
            current_name="${BASH_REMATCH[1]}"
            current_model=""
            has_mmproj=false
            has_mtp=false
            in_section=true
            continue
        fi

        if [[ "$in_section" == true ]]; then
            local key="${line%% *}"
            local val="${line#*= }"
            case "$key" in
                model)    current_model="$val" ;;
                mmproj)   has_mmproj=true ;;
                spec-type)
                    if [[ "$val" == *draft-mtp* ]]; then
                        has_mtp=true
                    fi
                    ;;
            esac
        fi
    done < "$MODELS_INI"

    # Emit last section
    if [[ "$in_section" == true && -n "$current_model" ]]; then
        local tags=""
        [[ "$has_mmproj" == true ]] && tags="mmproj"
        [[ "$has_mtp" == true ]] && { [[ -n "$tags" ]] && tags="$tags, "; tags="${tags}MTP"; }
        [[ -z "$tags" ]] && tags="-"
        printf "  %-30s %-50s %s\n" "$current_name" "$current_model" "$tags"
    fi

    echo ""
}

cmd_model_remove() {
    local preset_name="$1"
    if [[ -z "$preset_name" ]]; then
        err "Usage: llama-ctl model remove <preset-name>"
        exit 1
    fi

    if [[ ! -f "$MODELS_INI" ]]; then
        err "Models preset not found: $MODELS_INI"
        exit 1
    fi

    # Check if section exists
    if ! grep -q "^\[$preset_name\]" "$MODELS_INI"; then
        err "Preset '$preset_name' not found in $MODELS_INI"
        exit 1
    fi

    # Remove the section (from [name] to next [section] or EOF)
    local tmp
    tmp=$(mktemp)
    awk -v name="$preset_name" '
        BEGIN { in_section = 0 }
        /^\[/ {
            if (in_section) { in_section = 0 }
            if ($0 == "[" name "]") { in_section = 1; next }
            print
            next
        }
        !in_section { print }
    ' "$MODELS_INI" > "$tmp"

    mv "$tmp" "$MODELS_INI"
    ok "Removed preset '$preset_name' from $MODELS_INI"
}

cmd_model_refresh() {
    log "Rescanning models in $MODELS_DIR ..."
    regenerate_models_ini
}

cmd_model() {
    local subcmd="${1:-help}"
    shift || true
    case "$subcmd" in
        add)      cmd_model_add "$@" ;;
        list|ls)  cmd_model_list ;;
        remove|rm) cmd_model_remove "$@" ;;
        refresh)  cmd_model_refresh ;;
        *)        err "Unknown model command: $subcmd"
                  echo "Usage: llama-ctl model <add|list|remove|refresh>"
                  exit 1 ;;
    esac
}

# ─── Update commands ────────────────────────────────────────────────────────────

cmd_update_binary() {
    local repo; repo="$(find_repo)" || { err "Cannot locate llama.cpp repository."; exit 1; }
    log "Repo: $repo"

    # Pull latest changes
    log "Pulling latest changes..."
    if ! (cd "$repo" && git pull); then
        err "git pull failed. Resolve conflicts and retry."
        exit 1
    fi

    # Find build dir and rebuild
    local build_dir; build_dir="$(find_build)" || { err "Cannot locate build directory."; exit 1; }
    log "Rebuilding in $build_dir ..."

    # Read saved build state or use defaults
    local backend="auto" build_type="Release" jobs=""
    if [[ -f "$BUILD_STATE" ]]; then
        # shellcheck source=/dev/null
        . "$BUILD_STATE"
    fi

    if [[ -z "$jobs" ]]; then
        jobs=$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)
    fi

    if [[ "$backend" == "auto" ]]; then
        if command -v nvcc >/dev/null 2>&1; then
            backend="cuda"
        fi
    fi

    local cmake_args=(-DGGML_NATIVE=ON -DCMAKE_BUILD_TYPE="$build_type")
    [[ "$backend" != "cpu" ]] && cmake_args+=("-DGGML_${backend^^}=ON")

    log "cmake -B $build_dir/build ${cmake_args[@]}"
    cmake -S "$repo" -B "${build_dir}/build" "${cmake_args[@]}" || {
        err "cmake configure failed."
        exit 1
    }

    cmake --build "${build_dir}/build" -j "$jobs" --target llama-server || {
        err "cmake build failed."
        exit 1
    }

    ok "llama-server rebuilt successfully."
}

cmd_update_models() {
    log "Rescanning models..."
    regenerate_models_ini
}

cmd_update() {
    local mode="${1:-all}"
    case "$mode" in
        --binary|binary)  cmd_update_binary ;;
        --models|models)  cmd_update_models ;;
        --all|all|"")     cmd_update_binary; cmd_update_models ;;
        *)                err "Unknown update mode: $mode"
                          echo "Usage: llama-ctl update [--binary|--models|--all]"
                          exit 1 ;;
    esac

    # Restart server if running
    local mux; mux="$(detect_mux)" || true
    if [[ -n "$mux" ]] && is_running "$mux"; then
        log "Restarting server to apply changes..."
        cmd_stop
        sleep 1
        cmd_start
    fi
}

# ─── Main dispatcher ────────────────────────────────────────────────────────────

case "${1:-help}" in
    start)            cmd_start ;;
    stop)             cmd_stop ;;
    restart)          cmd_stop || true; cmd_start ;;
    status)           cmd_status ;;
    logs|attach)      cmd_logs ;;
    url)              cmd_url ;;
    webui)            case "${2:-help}" in
                        start)     cmd_webui_start ;;
                        stop)      cmd_webui_stop ;;
                        restart)   cmd_webui_restart ;;
                        status)    cmd_webui_status ;;
                        *)         err "Unknown webui command: $2"; cmd_help ;;
                      esac ;;
    help|-h|--help)  cmd_help ;;
    model)           cmd_model "${@:2}" ;;
    update)          cmd_update "${@:2}" ;;
    uninstall)       cmd_uninstall "$@" ;;
    *)               err "Unknown command: $1"; cmd_help ;;
esac
